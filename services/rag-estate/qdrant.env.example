# Example Qdrant credential file for services/rag-estate/compose.yaml.
#
# Copy to qdrant.env on the host and set a real key. This file carries NO real
# value. Keep the live copy mode 600 and never commit it.
#
# On SPECULAR-CORE the live copy is /mnt/u/runtime-secrets/rag-estate/qdrant.env.
#
# This is deliberately separate from runtime-live.env: the compose file declares
# it as ${QDRANT__SERVICE__API_KEY:?...}, so bringing the stack up without it
# fails loudly instead of starting an unauthenticated vector store.

QDRANT__SERVICE__API_KEY=replace-me
