# Example environment for services/rag-estate/compose.yaml.
#
# Copy to runtime-live.env on the host and fill in. This file carries NO real
# values. The API key lives in a separate file; see qdrant.env.example.
#
# On SPECULAR-CORE the live copy is /mnt/u/runtime-secrets/rag-estate/runtime-live.env.

# Directory holding the per-service env files and the TLS material. The compose
# file mounts <RAG_SECRET_ROOT>/tls into the containers read-only.
RAG_SECRET_ROOT=/path/to/runtime-secrets/rag-estate
RAG_TLS_ROOT=/path/to/runtime-secrets/rag-estate/tls

# Images. Production pins by digest (…@sha256:…) so a rebuild is reproducible;
# a tag works for a first bring-up.
QDRANT_IMAGE_REF=ghcr.io/atlasreaper311/qdrant-distroless:latest
RAMONE_MEMORY_IMAGE_REF=ghcr.io/atlasreaper311/ramone-memory:latest
ATLAS_CORPUS_IMAGE_REF=ghcr.io/atlasreaper311/atlas-corpus:latest
OLLAMA_RAG_KIT_IMAGE_REF=ghcr.io/atlasreaper311/ollama-rag-kit:latest

# "true" makes the vector stores refuse writes. Leave false for normal running.
WRITE_FREEZE=false

# Host-side ports. All three publish on loopback only, which is deliberate:
# WSL forwards loopback publishes to Windows itself, and anything wider needs a
# netsh portproxy rule that then shadows that forwarding. See README.md.
RAMONE_MEMORY_HOST_PORT=8091
ATLAS_CORPUS_HOST_PORT=18092
OLLAMA_RAG_KIT_HOST_PORT=8093
