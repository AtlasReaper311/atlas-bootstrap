# Example of the generated endpoint file for services/rag-estate/compose.yaml.
#
# This file is NOT hand-maintained in normal running. compose.yaml declares it
# as a relative env_file with required: true, so a copy must sit beside the
# deployed compose.yaml, and on SPECULAR-CORE the llama.cpp launcher
# L:\Models\llama-cuda\start-ramone-mtp-cuda.ps1 rewrites it on every start so
# the RAG kit follows the model server when the WSL IP changes.
#
# Create it by hand only to bring the stack up before the model server has run.

OPENAI_BASE_URL=http://127.0.0.1:8095/v1
